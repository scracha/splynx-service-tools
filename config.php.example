// Bounding box for New Zealand — anything outside gets clamped to the default
$geoBoundary = [
    'lat_min' => -47.5,   // south
    'lat_max' => -34.0,   // north
    'lng_min' => 165.0,   // west
    'lng_max' => 179.0,   // east
];

